        while i > 0:
            parent = (i - 1) // 2

            if self.heap[i] > self.heap[parent]:
                self.heap[i], self.heap[parent] = self.heap[parent], self.heap[i]
                i = parent
            else:
                break

    def delete_max(self):
        if len(self.heap) == 0:
            print("Heap is empty")
            return

        max_value = self.heap[0]
        last_value = self.heap.pop()

        if len(self.heap) > 0:
            self.heap[0] = last_value
            self.heapify(0)

        print("Deleted highest priority job:", max_value)

    def heapify(self, i):
        n = len(self.heap)

        while True:
            largest = i
            left = 2 * i + 1
            right = 2 * i + 2

            if left < n and self.heap[left] > self.heap[largest]:
                largest = left

            if right < n and self.heap[right] > self.heap[largest]:
                largest = right

            if largest != i:
                self.heap[i], self.heap[largest] = \
                    self.heap[largest], self.heap[i]
                i = largest
            else:
                break

    def peek(self):
        if len(self.heap) == 0:
            print("Heap is empty")
        else:
            print("Highest priority job:", self.heap[0])

    def display(self):
        if len(self.heap) == 0:
            print("Heap is empty")
        else:
            print("Jobs in Heap Order:")
            print(*self.heap)

